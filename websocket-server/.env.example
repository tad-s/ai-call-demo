# rename this to .env

OPENAI_API_KEY=""
PUBLIC_URL=""

# Web検索ツール（web_search function calling）用
# WEB_SEARCH_PROVIDER: "tavily" または "brave" を切り替えて比較できる
WEB_SEARCH_PROVIDER="tavily"
TAVILY_API_KEY=""
BRAVE_SEARCH_API_KEY=""

# 任意。設定しない場合はローカルのファイル(config.json/presets.json/users.json)に保存される
DATABASE_URL=""

# 任意。初回起動時にユーザーが1人もいなければ管理者アカウントを自動作成する。
# 指定しない場合はランダムなパスワードが生成され、起動時のログに一度だけ表示される
INITIAL_ADMIN_USERNAME=""
INITIAL_ADMIN_PASSWORD=""
